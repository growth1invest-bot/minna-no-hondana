{
  "name": "hondana-v12-validation",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/data.test.mjs tests/controller.test.mjs tests/transport.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-hondana-v12 --only firestore --config ../../firebase.v12.json 'node --test tests/firestore.test.mjs'",
    "test:connection": "python3 scripts/cache-sdk.py && firebase emulators:exec --project demo-hondana-v12 --only auth,firestore --config ../../firebase.v12.connection.json '../../node_modules/.bin/playwright test --config=../../playwright.v12-connection.config.cjs --workers=1'",
    "test:live": "python3 scripts/cache-sdk.py && HONDANA_READONLY_FIREBASE_CHECK=1 ../../node_modules/.bin/playwright test --config=../../playwright.v12-live.config.cjs --workers=1"
  },
  "devDependencies": {
    "firebase": "13.4.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-tools": "15.37.0"
  }
}
